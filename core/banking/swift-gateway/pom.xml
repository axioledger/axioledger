<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.axioledger</groupId>
  <artifactId>axio-banking-translator</artifactId>
  <version>0.2.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>AXIO Banking Translator Service</name>
  <description>
    Spring Boot service: SWIFT MGW → ISO-20022 parsing → KPX RWA Token mint.
    Runs co-located with SWIFT Microgateway on the dedicated banking server
    (/mnt/q/core/banking/) to satisfy PCI DSS isolation (DP-4).
    OAuth2 + mTLS authentication against SWIFT Sandbox (v0.2.0).
    Collateral ratio read dynamically from Treasury DAO — never hardcoded.
  </description>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.2</version>
    <relativePath/>
  </parent>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!-- SWIFT SDK versions — installed locally at /mnt/q/core/banking/swift-gateway/ -->
    <!-- Install via: mvn install:install-file (see scripts/install-swift-sdk.sh)     -->
    <swift-messaging-sdk.version>1.17.4</swift-messaging-sdk.version>
    <swift-security-sdk.version>2.17.5-6</swift-security-sdk.version>
    <swift-sdk-openapi.version>2.17.10-6</swift-sdk-openapi.version>

    <!-- Third-party -->
    <okhttp.version>4.12.0</okhttp.version>
    <gson.version>2.10.1</gson.version>
    <web3j.version>4.10.3</web3j.version>
  </properties>

  <dependencies>
    <!-- ── Spring Boot ────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-configuration-processor</artifactId>
      <optional>true</optional>
    </dependency>

    <!-- ── SWIFT Security SDK (OAuth2 + mTLS) — install locally first ────── -->
    <dependency>
      <groupId>com.swift.commons.oauth</groupId>
      <artifactId>swift-security-sdk</artifactId>
      <version>${swift-security-sdk.version}</version>
      <classifier>jar-with-dependencies</classifier>
      <scope>provided</scope>
    </dependency>

    <!-- ── SWIFT Messaging SDK (ISO-20022 parsing) — install locally first ─ -->
    <dependency>
      <groupId>com.swift</groupId>
      <artifactId>swift-messaging-sdk</artifactId>
      <version>${swift-messaging-sdk.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- ── Web3j (KPX contract interaction) ──────────────────────────────── -->
    <dependency>
      <groupId>org.web3j</groupId>
      <artifactId>core</artifactId>
      <version>${web3j.version}</version>
    </dependency>

    <!-- ── HTTP client (VRQ API calls) ───────────────────────────────────── -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp.version}</version>
    </dependency>

    <!-- ── JSON ──────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- ── Test ──────────────────────────────────────────────────────────── -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Soft tests run without SWIFT SDK; skip hard tests until v0.2.0 gate -->
          <excludes>
            <exclude>**/hard/**Test.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
