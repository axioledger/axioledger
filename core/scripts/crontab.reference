# AXIOLEDGER Cron Jobs Reference
# File: /root/core/scripts/crontab.reference
# Install: sudo crontab -e (as root)
#
# Node.js required: node >= 20.0.0
# Check: node --version

# ─── RWA Yield Buyback ────────────────────────────────────────────────────
# Mỗi ngày lúc 02:00 AM — trích 10% yield RWA mua lại và đốt $AXQ
0 2 * * * root /usr/bin/node /root/core/scripts/rwa-yield-buyback.js >> /root/logs/treasury.log 2>&1

# ─── AXQ Emission Trigger ─────────────────────────────────────────────────
# Kiểm tra ΔTVL_RWA mỗi 6 giờ — kích hoạt Value-Pegged Emission nếu cần
0 */6 * * * root /usr/bin/node /root/core/scripts/axq-emission.js >> /root/logs/treasury.log 2>&1

# ─── File Integrity Monitoring ────────────────────────────────────────────
# Quét toàn vẹn tệp tin mỗi nửa đêm — Legal Audit Trail
0 0 * * * root /usr/bin/node /root/core/scripts/integrity-check.js >> /root/logs/security.log 2>&1

# ─── Supply Chain Scanner ─────────────────────────────────────────────────
# VRQ node quét DApp/npm packages mỗi 15 phút — detect Typosquatting
*/15 * * * * root /usr/bin/node /root/core/scripts/supply-chain-scan.js >> /root/logs/security.log 2>&1

# ─── GitHub Audit ─────────────────────────────────────────────────────────
# Kiểm toán GitHub Orgs mỗi ngày Chủ Nhật 01:00 AM
0 1 * * 0 root /root/core/github/w7-audit.sh >> /root/logs/github-audit.log 2>&1

# ─── Maintenance ──────────────────────────────────────────────────────────
# Dọn log cũ hơn 30 ngày — Chủ Nhật 03:00 AM
0 3 * * 0 root find /root/logs/ -type f -mtime +30 -name "*.log" -delete 2>/dev/null; true

# ─── ANS Indexer ──────────────────────────────────────────────────────────
# Khởi động ANS Indexer nếu bị tắt (mỗi 5 phút)
# Uncomment sau khi smart contracts được deploy (v1.0.0):
# */5 * * * * root pgrep -f ans-indexer.js || node /root/core/scripts/ans-indexer.js >> /root/logs/ans.log 2>&1 &
