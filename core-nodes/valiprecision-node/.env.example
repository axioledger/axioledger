# VPX Oracle Node — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
#
# Usage:
#   cp .env.example .env
#   node src/oracle-node.js

# ── RPC endpoint (required for on-chain push) ─────────────────────────────────
# Localnet:  http://127.0.0.1:8545
# Sepolia:   https://sepolia.infura.io/v3/<KEY>
# Mainnet:   https://mainnet.infura.io/v3/<KEY>
RPC_URL=http://127.0.0.1:8545

# ── Deployed VPXOracleFeed contract address ───────────────────────────────────
# Sepolia:  see identity-declaration.json → $VPX pillar
# Localnet: deploy with forge script first
VPX_ORACLE_CONTRACT=0x0000000000000000000000000000000000000000

# ── Oracle operator private key (hot wallet — fund with minimal ETH for gas) ──
# If not set, node runs in DRY-RUN mode (fetches prices but does not push).
# NEVER use a wallet with significant holdings here.
# ORACLE_PRIVATE_KEY=0x...

# ── AXQ mock price (used until AXQ is listed on CEX) ─────────────────────────
AXQ_MOCK_PRICE=0.015

# ── Logging ───────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
LOG_LEVEL=info
