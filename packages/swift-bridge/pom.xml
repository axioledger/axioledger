<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.axioledger.swift</groupId>
  <artifactId>swift-bridge</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <description>SWIFT GPI &amp; MGW Integration Layer for Axioledger RWA Treasury (Giai đoạn B)</description>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- SWIFT SDK versions (installed via mvn install:install-file — 2-layer unzip) -->
    <swift.security.sdk.version>2.17.5-6</swift.security.sdk.version>
    <!-- Third-party -->
    <okhttp3.version>4.12.0</okhttp3.version>
    <gson.version>2.9.1</gson.version>
    <slf4j.version>2.0.0</slf4j.version>
    <swagger.annotations.version>2.1.13</swagger.annotations.version>
    <junit.version>5.10.2</junit.version>
    <mockito.version>5.11.0</mockito.version>
  </properties>

  <dependencies>
    <!-- ── SWIFT Security SDK (install via 2-layer unzip + mvn install:install-file) ── -->
    <dependency>
      <groupId>com.swift.commons.oauth</groupId>
      <artifactId>swift-security-sdk</artifactId>
      <version>${swift.security.sdk.version}</version>
      <classifier>jar-with-dependencies</classifier>
      <scope>provided</scope>
    </dependency>

    <!-- ── HTTP Client ── -->
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>okhttp</artifactId>
      <version>${okhttp3.version}</version>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>logging-interceptor</artifactId>
      <version>${okhttp3.version}</version>
    </dependency>

    <!-- ── JSON ── -->
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <!-- ── Logging ── -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-reload4j</artifactId>
      <version>${slf4j.version}</version>
      <exclusions>
        <exclusion><groupId>ch.qos.reload4j</groupId><artifactId>reload4j</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>ch.qos.reload4j</groupId>
      <artifactId>reload4j</artifactId>
      <version>1.2.22</version>
    </dependency>

    <!-- ── OpenAPI annotations ── -->
    <dependency>
      <groupId>io.swagger.core.v3</groupId>
      <artifactId>swagger-annotations</artifactId>
      <version>${swagger.annotations.version}</version>
    </dependency>

    <!-- ── JAXB (required by SWIFT SAG library) ── -->
    <dependency>
      <groupId>javax.xml.bind</groupId>
      <artifactId>jaxb-api</artifactId>
      <version>2.3.0</version>
    </dependency>

    <!-- ── Test ── -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.squareup.okhttp3</groupId>
      <artifactId>mockwebserver</artifactId>
      <version>${okhttp3.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>17</source>
          <target>17</target>
          <encoding>UTF-8</encoding>
          <!-- SwiftSessionManager uses SWIFT Security SDK (provided scope, installed Phase A).
               Exclude from compile until Phase A gate is complete (BIC filing + SDK install).
               All other classes (GpiTrackerClient, SwiftKpxBridge, etc.) compile without SDK. -->
          <excludes>
            <exclude>com/axioledger/swift/session/SwiftSessionManager.java</exclude>
          </excludes>
          <!-- Legacy test files use old API (function-injection constructor, AmlCheckResult).
               Superseded by vrq/soft/ and kpx/soft/ — exclude from test compile. -->
          <testExcludes>
            <testExclude>com/axioledger/swift/soft/SwiftVrqAmlCheckerSoftTest.java</testExclude>
            <testExclude>com/axioledger/swift/soft/SwiftSessionManagerSoftTest.java</testExclude>
            <testExclude>com/axioledger/swift/session/soft/SwiftSessionManagerSoftTest.java</testExclude>
            <testExclude>com/axioledger/swift/soft/RwaSettlementMapperSoftTest.java</testExclude>
            <testExclude>com/axioledger/swift/soft/SwiftKpxBridgeSoftTest.java</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <!-- Run all 5 soft test classes. Hard tests require live SWIFT creds (Phase A gate).
               Legacy swift/soft/ tests use old API (excluded from compile). -->
          <test>GpiTrackerClientSoftTest,SwiftKpxBridgeSoftTest,RwaSettlementMapperSoftTest,RwaSettlementMapperChangedTransactionsSoftTest,SwiftVrqAmlCheckerSoftTest</test>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>single</goal></goals>
          </execution>
        </executions>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
